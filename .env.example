# ==========================================
# TRAVORA - ENVIRONMENT CONFIGURATION
# ==========================================

# Port configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travora?schema=public"

# Authentication secret for signing JWTs
AUTH_SECRET="travora-super-secure-jwt-secret-key-change-in-production-2026"

# ------------------------------------------
# External APIs (Configurable / Optional)
# ------------------------------------------

# AI API Key (Google Gemini or OpenAI)
# If provided, enables live LLM-powered itinerary generation and conversational adjustments.
AI_API_KEY=""

# Translation API Key (Google Cloud Translation / LibreTranslate / DeepL)
# Note: Travora includes a built-in multi-engine translator that functions even without a key via public endpoints!
TRANSLATION_API_KEY=""

# Currency API Key (ExchangeRate-API / OpenExchangeRates)
# Note: Travora utilizes open.er-api.com live real-time rates out-of-the-box without requiring a key!
CURRENCY_API_KEY=""

# Weather API Key (OpenWeatherMap / WeatherAPI)
# Note: Travora defaults to Open-Meteo real-time global weather and 7-day forecast with NO key required!
WEATHER_API_KEY=""

# Maps API Key (Mapbox / Google Maps)
# Note: Travora integrates Leaflet + OpenStreetMap + OSRM routing out-of-the-box with NO key required!
MAPS_API_KEY=""

# Hotel API Key (Amadeus / Booking.com API)
# Note: Travora includes real hotel listings and live booking deep-link provider redirects out-of-the-box!
HOTEL_API_KEY=""

# Places API Key (Foursquare / Google Places)
PLACES_API_KEY=""
